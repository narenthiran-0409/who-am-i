# Public URL only. Leave empty when /api is reverse-proxied to ASP.NET Core.
VITE_CONTACT_API_BASE_URL=
# Local Vite proxy target. This is not exposed in the client bundle.
CONTACT_API_PROXY_TARGET=http://127.0.0.1:5080
# Optional separate public content API; otherwise uses VITE_CONTACT_API_BASE_URL or same origin.
VITE_PORTFOLIO_API_BASE_URL=

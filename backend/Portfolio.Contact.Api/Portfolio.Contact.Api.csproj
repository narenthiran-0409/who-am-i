<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>who-am-i-contact-api</UserSecretsId>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="MailKit" Version="4.18.0" /></ItemGroup>
  <ItemGroup><Content Update="Content/**/*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
</Project>
